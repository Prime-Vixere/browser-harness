#!/usr/bin/env bash
# Run browser-harness against the isolated Chrome — its own process, its own
# profile, its own debug port — instead of the one every other session shares.
# Usage is identical to browser-harness:  iso <<'PY' ... PY
set -euo pipefail

PORT="${BU_ISO_PORT:-9333}"
NAME="${BU_NAME:-iso}"

# The isolated instance serves /json/version (the shared one 404s on it now), and
# its profile is not in daemon.py's PROFILES, so file discovery can never find it.
# Resolving the URL here is what makes a stale pasted browser id impossible.
WS=$(curl -fsS --max-time 5 "http://127.0.0.1:$PORT/json/version" \
     | sed -n 's/.*"webSocketDebuggerUrl" *: *"\([^"]*\)".*/\1/p') || true
if [ -z "$WS" ]; then
  echo "iso: no isolated Chrome on 127.0.0.1:$PORT — see interaction-skills/isolated-instance.md" >&2
  exit 1
fi

# Chrome mints a new browser id every launch, and the daemon reads BU_CDP_WS once,
# at birth: ensure_daemon() returns early for a live socket, so exporting a fresh
# URL past an old daemon changes nothing. Retire a daemon still dialling a dead id.
PID_FILE="/tmp/bu-$NAME.pid"
if [ -f "$PID_FILE" ] && PID=$(cat "$PID_FILE" 2>/dev/null) && kill -0 "$PID" 2>/dev/null; then
  if ! ps -p "$PID" -Eo command= 2>/dev/null | grep -qF "BU_CDP_WS=$WS"; then
    kill "$PID" 2>/dev/null || true
    rm -f "/tmp/bu-$NAME.sock" "$PID_FILE"
  fi
fi

BU_NAME="$NAME" BU_CDP_WS="$WS" exec browser-harness "$@"
